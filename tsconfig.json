/*
 * tsconfig.json — TypeScript compiler settings for the app
 * (not in the original architecture.md skeleton; required by agents.md → TypeScript)
 *
 * Description:
 *   Compiler options for src/ and vite.config.ts. Used by `npm run typecheck`
 *   (tsc --noEmit) and by editors.
 *
 * Tasks:
 *   1. Set "strict": true (agents.md → TypeScript); no implicit any.
 *   2. Target modern browsers (ES2022), module "ESNext", moduleResolution "Bundler".
 *   3. "jsx": "react-jsx"; "isolatedModules": true (Vite requirement).
 *   4. Include "vite/client" types (CSS Modules, worker imports).
 *   5. "include": ["src", "functions", "vite.config.ts"] (functions/: Cloudflare
 *      Pages Function for /models/*; T12).
 *
 * Dependencies:
 *   Dev: typescript, vite (client types).
 *   Used by: tsc, Vite, ESLint (typescript-eslint), Vitest.
 *
 * Status: populated for modules and tests (Phase 3 pre-work); React/JSX types are
 *   added when React is installed.
 */
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "functions",
    "vite.config.ts"
  ]
}

