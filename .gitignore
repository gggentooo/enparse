# =============================================================================
# .gitignore — repository-wide ignore rules
# =============================================================================
#
# Description:
#   Matches dev_meta/agents.md and architecture.md:
#   - npm is the package manager; package-lock.json is committed.
#   - dist/ is generated by Vite.
#   - Training data, checkpoints, and exports stay out of git
#     (details in training/.gitignore).
#   - Shipped model files in public/models/ ARE committed, via Git LFS
#     (.gitattributes). Do not ignore *.onnx here.
#
# Dependencies:
#   training/.gitignore (training-specific rules); .gitattributes (Git LFS).
# =============================================================================

# Dependencies (root and training/js/)
node_modules/

# Build output (Vite)
dist/
.vite/
*.tsbuildinfo

# Other package managers' lockfiles (npm only; package-lock.json is committed)
yarn.lock
pnpm-lock.yaml

# Environment files
.env
.env.*

# Logs
*.log
logs/
npm-debug.log*

# Tests (Vitest, Playwright)
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Python (training/)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Training tool caches created in the working directory
unsloth_compiled_cache/

# Caches
.cache/

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Packed archives
*.tgz

# Local agent instructions (owner preference)
CLAUDE.md
